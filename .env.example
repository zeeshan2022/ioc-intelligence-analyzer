# =============================================================================
# IOC Intelligence Analyzer - environment template
# =============================================================================
# Copy this file to `.env` and fill in your API keys:
#
#     cp .env.example .env
#
# NEVER commit `.env` (it is git-ignored). Only non-secret defaults are listed
# here. See docs/INSTALL.md for provider key registration links.
# -----------------------------------------------------------------------------
# Threat intelligence provider API keys (Release 1 connectors)
# -----------------------------------------------------------------------------
# VirusTotal v3 - https://www.virustotal.com/gui/my-apikey
VT_API_KEY=
# AbuseIPDB v2 - https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# GreyNoise (community or enterprise) - https://viz.greynoise.io/account/api-key
GREYNOISE_API_KEY=

# -----------------------------------------------------------------------------
# Runtime behaviour
# -----------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
IOC_LOG_LEVEL=INFO
# Emit structured JSON logs to stderr (machine parsing / SIEM shipping)
IOC_JSON_LOGS=false
# Report output directory (created automatically)
IOC_REPORT_DIR=reports
# Skip all outbound provider calls (privacy / air-gapped triage)
IOC_OFFLINE=false

# -----------------------------------------------------------------------------
# Connector hardening knobs
# -----------------------------------------------------------------------------
# Per-request HTTP timeout in seconds
IOC_TIMEOUT_SECONDS=15
# Maximum attempts per request (bounded retries with exponential backoff)
IOC_MAX_RETRIES=3
# Base delay multiplier between retries
IOC_BACKOFF_FACTOR=0.7
